{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "brand-1", "color": "#e6fff3", "name": "Brand 1" },
				{ "slug": "brand-2", "color": "#b3ffdb", "name": "Brand 2" },
				{ "slug": "brand-3", "color": "#80ffc4", "name": "Brand 3" },
				{ "slug": "brand-4", "color": "#4dffac", "name": "Brand 4" },
				{ "slug": "brand-5", "color": "#1aff94", "name": "Brand 5" },
				{ "slug": "brand-6", "color": "#00ff88", "name": "Brand 6 · 主色" },
				{ "slug": "brand-7", "color": "#00d974", "name": "Brand 7" },
				{ "slug": "brand-8", "color": "#00a658", "name": "Brand 8" },
				{ "slug": "brand-9", "color": "#00733d", "name": "Brand 9" },
				{ "slug": "brand-10", "color": "#004022", "name": "Brand 10" },
				{ "slug": "gray-1", "color": "#ffffff", "name": "Gray 1" },
				{ "slug": "gray-2", "color": "#fafafa", "name": "Gray 2" },
				{ "slug": "gray-3", "color": "#f5f5f5", "name": "Gray 3" },
				{ "slug": "gray-4", "color": "#f0f0f0", "name": "Gray 4" },
				{ "slug": "gray-5", "color": "#d9d9d9", "name": "Gray 5" },
				{ "slug": "gray-6", "color": "#bfbfbf", "name": "Gray 6" },
				{ "slug": "gray-7", "color": "#8c8c8c", "name": "Gray 7" },
				{ "slug": "gray-8", "color": "#595959", "name": "Gray 8" },
				{ "slug": "gray-9", "color": "#434343", "name": "Gray 9" },
				{ "slug": "gray-10", "color": "#262626", "name": "Gray 10" },
				{ "slug": "gray-11", "color": "#1f1f1f", "name": "Gray 11" },
				{ "slug": "gray-12", "color": "#141414", "name": "Gray 12" },
				{ "slug": "gray-13", "color": "#000000", "name": "Gray 13" },
				{ "slug": "success", "color": "#52c41a", "name": "Success" },
				{ "slug": "warning", "color": "#faad14", "name": "Warning" },
				{ "slug": "error", "color": "#ff4d4f", "name": "Error" },
				{ "slug": "info", "color": "#1677ff", "name": "Info" }
			]
		},
		"spacing": {
			"custom": true,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "size": "4px", "name": "1 · 4px" },
				{ "slug": "20", "size": "8px", "name": "2 · 8px" },
				{ "slug": "30", "size": "12px", "name": "3 · 12px" },
				{ "slug": "40", "size": "16px", "name": "4 · 16px" },
				{ "slug": "50", "size": "24px", "name": "5 · 24px" },
				{ "slug": "60", "size": "32px", "name": "6 · 32px" },
				{ "slug": "70", "size": "48px", "name": "7 · 48px" },
				{ "slug": "80", "size": "64px", "name": "8 · 64px" },
				{ "slug": "90", "size": "96px", "name": "9 · 96px" }
			]
		},
		"typography": {
			"custom": true,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "Georgia, \"Songti SC\", \"SimSun\", serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"SF Mono\", Monaco, \"Cascadia Code\", Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "13px", "name": "Small" },
				{ "slug": "medium", "size": "15px", "name": "Medium" },
				{ "slug": "large", "size": "18px", "name": "Large" },
				{ "slug": "x-large", "size": "22px", "name": "X-Large" },
				{ "slug": "xx-large", "size": "28px", "name": "XX-Large" },
				{ "slug": "xxx-large", "size": "36px", "name": "XXX-Large" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"custom": true,
			"presets": [
				{ "slug": "sm", "shadow": "0 1px 2px rgba(0,0,0,0.04)", "name": "Small" },
				{ "slug": "md", "shadow": "0 4px 8px rgba(0,0,0,0.06)", "name": "Medium" },
				{ "slug": "lg", "shadow": "0 8px 24px rgba(0,0,0,0.08)", "name": "Large" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--gray-1)",
			"text": "var(--wp--preset--color--gray-10)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			},
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--brand-8)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--brand-6)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600",
					"lineHeight": "1.35"
				}
			}
		}
	}
}